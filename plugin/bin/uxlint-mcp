#!/usr/bin/env bash
# Launch uxlint's MCP server for the Claude Code plugin.
#
# A plugin can't ship a compiled binary for four platforms without becoming a 60MB download, and
# requiring "install the CLI first" turns a one-click install into a support thread. So: use the
# uxlint already on this machine if there is one, and otherwise fetch it once, into the plugin's own
# persistent data directory, with the same checksum-verifying installer the website documents.
#
# Nothing here is silent. The install prints what it is doing to stderr — stdout is the JSON-RPC
# channel and must carry nothing else — and every byte comes from the published release the install
# script verifies. `UXLINT_BIN` overrides everything, for a local build.
set -euo pipefail

log() { printf 'uxlint: %s\n' "$*" >&2; }

# 1. An explicit override wins — a developer testing a local build.
if [ -n "${UXLINT_BIN:-}" ] && [ -x "${UXLINT_BIN}" ]; then
	exec "${UXLINT_BIN}" mcp "$@"
fi

# 2. The version this plugin ships against. Everything below is keyed on it.
data="${CLAUDE_PLUGIN_DATA:-${CLAUDE_PLUGIN_ROOT:-$HOME/.uxlint}}"
manifest="${CLAUDE_PLUGIN_ROOT:-}/.claude-plugin/plugin.json"
version="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$manifest" 2>/dev/null | head -1)"
if [ -z "$version" ]; then
	log "could not read the plugin's version from $manifest — installing the latest release instead"
fi

# 3. Already installed (install.sh, mise, a package manager) — use it, but only if it is at least the
#    version this plugin ships against. Deferring to an OLDER uxlint on PATH re-opens the very trap the
#    pinning below closes: the plugin updates, the binary it actually runs does not, and /v1/me starts
#    telling the user to upgrade something `/plugin update` cannot reach. (A mise install pinned at
#    0.1.24 shadowed a 0.1.27 plugin exactly this way.) A NEWER one is fine — that is the user tracking
#    releases ahead of us, and installing a second copy behind their back would be pure waste.
if command -v uxlint >/dev/null 2>&1; then
	have="$(uxlint --version 2>/dev/null | awk '{print $2}')"
	newest="$(printf '%s\n%s\n' "$have" "$version" | sort -V 2>/dev/null | tail -1)"
	if [ -z "$version" ] || [ "$have" = "$version" ] || [ "$newest" = "$have" ]; then
		exec uxlint mcp "$@"
	fi
	log "uxlint ${have:-?} on PATH is older than this plugin's $version — using the pinned build instead"
fi

# 4. Otherwise install into the plugin's data directory, at the version THIS PLUGIN declares.
#
#    The version scoping is what makes `/plugin update` mean something. The plugin ships a launcher,
#    not a binary, so without it the first install would pin a user to that binary forever: the plugin
#    would update, the CLI underneath would not, and the server would start telling them to upgrade a
#    thing they had no way to upgrade. Keying the path on the version means a plugin update fetches the
#    matching CLI on next start, and an unchanged version reuses what's already there.
#
#    CLAUDE_PLUGIN_DATA survives plugin updates, so previous versions stay cached (they cost ~10MB
#    each; delete the directory to reclaim it).
bin="$data/bin/${version:-latest}/uxlint"
if [ ! -x "$bin" ]; then
	log "installing uxlint ${version:-latest} for this plugin (once per version)"
	mkdir -p "$(dirname "$bin")"
	# NB `env`, not a bare prefix: ${version:+VAR=value} expands into COMMAND position (bash decides
	# what is an assignment before it expands anything), so without it this died with
	# "UXLINT_VERSION=v0.1.27: command not found" and the plugin fell through to a failed install.
	# UXLINT_MANAGED=1 silences the installer's PATH advice: this directory is version-scoped and
	# ours, and telling someone to put it on their PATH would pin them to one build forever —
	# precisely the trap the scoping avoids.
	# The same installer the docs give: detects OS/arch, verifies the published checksum, and never
	# touches anything outside the directory it is pointed at. UXLINT_VERSION pins the exact release,
	# so the binary and the plugin can't disagree about what version this is.
	if ! curl -fsSL https://uxlint.net/install.sh \
		| env UXLINT_MANAGED=1 UXLINT_INSTALL_DIR="$(dirname "$bin")" ${version:+UXLINT_VERSION="v$version"} sh >&2; then
		# The pinned release may not exist YET. The marketplace serves this manifest from `main`, so
		# the moment a version bump merges it advertises a version whose binaries are still building —
		# a window of a few minutes per release in which a first install would simply fail. Rather
		# than rely on nobody installing during it, fall back to the newest published release and say
		# so. The fallback lives in its own directory and the PINNED path is tried first on every
		# subsequent start, so this self-heals the moment the release lands.
		log "uxlint v$version isn't published yet (a release in flight?) — using the newest release for now"
		bin="$data/bin/fallback/uxlint"
		mkdir -p "$(dirname "$bin")"
		if ! curl -fsSL https://uxlint.net/install.sh \
			| env UXLINT_MANAGED=1 UXLINT_INSTALL_DIR="$(dirname "$bin")" sh >&2; then
			log "install failed — install it yourself with: curl -fsSL https://uxlint.net/install.sh | sh"
			exit 1
		fi
	fi
fi

exec "$bin" mcp "$@"
