#!/usr/bin/env bash
# Launch uxlint's MCP server for the Claude Code plugin.
#
# A plugin can't ship a compiled binary for four platforms without becoming a 60MB download, and
# requiring "install the CLI first" turns a one-click install into a support thread. So: use the
# uxlint already on this machine if there is one, and otherwise fetch it once, into the plugin's own
# persistent data directory, with the same checksum-verifying installer the website documents.
#
# Nothing here is silent. The install prints what it is doing to stderr — stdout is the JSON-RPC
# channel and must carry nothing else — and every byte comes from the published release the install
# script verifies. `UXLINT_BIN` overrides everything, for a local build.
set -euo pipefail

log() { printf 'uxlint: %s\n' "$*" >&2; }

# 1. An explicit override wins — a developer testing a local build.
if [ -n "${UXLINT_BIN:-}" ] && [ -x "${UXLINT_BIN}" ]; then
	exec "${UXLINT_BIN}" mcp "$@"
fi

# 2. Already installed (install.sh, mise, a package manager) — use it, and stay on the user's own
#    version rather than quietly running a second copy that updates on a different schedule.
if command -v uxlint >/dev/null 2>&1; then
	exec uxlint mcp "$@"
fi

# 3. Otherwise install into the plugin's data directory, at the version THIS PLUGIN declares.
#
#    The version scoping is what makes `/plugin update` mean something. The plugin ships a launcher,
#    not a binary, so without it the first install would pin a user to that binary forever: the plugin
#    would update, the CLI underneath would not, and the server would start telling them to upgrade a
#    thing they had no way to upgrade. Keying the path on the version means a plugin update fetches the
#    matching CLI on next start, and an unchanged version reuses what's already there.
#
#    CLAUDE_PLUGIN_DATA survives plugin updates, so previous versions stay cached (they cost ~10MB
#    each; delete the directory to reclaim it).
data="${CLAUDE_PLUGIN_DATA:-${CLAUDE_PLUGIN_ROOT:-$HOME/.uxlint}}"
manifest="${CLAUDE_PLUGIN_ROOT:-}/.claude-plugin/plugin.json"
version="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$manifest" 2>/dev/null | head -1)"
if [ -z "$version" ]; then
	log "could not read the plugin's version from $manifest — installing the latest release instead"
fi
bin="$data/bin/${version:-latest}/uxlint"
if [ ! -x "$bin" ]; then
	log "installing uxlint ${version:-latest} for this plugin (once per version)"
	mkdir -p "$(dirname "$bin")"
	# The same installer the docs give: detects OS/arch, verifies the published checksum, and never
	# touches anything outside the directory it is pointed at. UXLINT_VERSION pins the exact release,
	# so the binary and the plugin can't disagree about what version this is.
	if ! curl -fsSL https://uxlint.net/install.sh \
		| UXLINT_INSTALL_DIR="$(dirname "$bin")" ${version:+UXLINT_VERSION="v$version"} sh >&2; then
		log "install failed — install it yourself with: curl -fsSL https://uxlint.net/install.sh | sh"
		exit 1
	fi
fi

exec "$bin" mcp "$@"
