		"mcp-server",
		"modelcontextprotocol",
		"lighthouse",
		"code-review"
	],
	"homepage": "https://uxlint.net",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/uxlint-net/uxlint-cli.git"
	},
	"bugs": {
		"url": "https://github.com/uxlint-net/uxlint-cli/issues"
	},
	"license": "BUSL-1.1",
	"author": {
		"name": "uxlint",
		"url": "https://uxlint.net"
	},
	"type": "commonjs",
	"bin": {
		"uxlint": "bin/uxlint.js"
	},
	"files": [
		"bin/uxlint.js",
		"README.md"
	],
	"engines": {
		"node": ">=18"
	},
